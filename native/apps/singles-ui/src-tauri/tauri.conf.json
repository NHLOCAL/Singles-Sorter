{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "מסדר הסינגלים",
  "version": "15.0.0-beta.2",
  "identifier": "com.nhlocal.singlesorter",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "capabilities": [
        "main-read-only"
      ],
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "../public/icon.png"
    ]
  }
}
