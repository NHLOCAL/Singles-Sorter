{
  "name": "singles-sorter-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "test:renderer": "python tests/renderer.py",
    "tauri": "tauri",
    "build:desktop": "tauri build --no-bundle",
    "test:desktop": "python tests/desktop.py"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
